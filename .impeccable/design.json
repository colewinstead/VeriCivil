      "html": "<span class=\"ds-identity\">VeriCivil <span>Desktop preview</span></span>",
      "css": ".ds-identity{color:var(--muted,#536960);font-size:12px;font-family:var(--font-manrope,-apple-system),BlinkMacSystemFont,\"Segoe UI\",sans-serif;}.ds-identity>span{display:inline-block;margin-left:10px;padding-left:10px;border-left:1px solid var(--line,#cedbd4)}"
    },
    {
      "name": "Profile trace and station cursor",
      "kind": "custom",
      "description": "Schematic excerpt of the existing line grammar; synthetic illustration only.",
      "html": "<svg class=\"ds-profile\" viewBox=\"0 0 320 130\" role=\"img\" aria-label=\"Synthetic lane traces and selected station\"><path class=\"ds-left\" d=\"M10 100H75L135 30H225L290 100H310\"/><path class=\"ds-right\" d=\"M10 30H75L135 100H225L290 30H310\"/><path class=\"ds-cursor\" d=\"M170 10V120\"/></svg>",
      "css": ".ds-profile{display:block;width:100%;max-width:400px;background:var(--raised,#f3f7f5)}.ds-profile path{fill:none;stroke-width:2.8}.ds-profile .ds-left{stroke:var(--series-teal,#137869)}.ds-profile .ds-right{stroke:var(--series-right,#90600d);stroke-dasharray:7 4}.ds-profile .ds-cursor{stroke:var(--station-cursor,var(--ink,#1f302c));stroke-width:1.4}"
    }
  ],
  "narrative": {
    "northStar": "Alignment review desk",
    "overview": "This system applies to the Electron Superelevation preview, whose entry point is `web/desktop/renderer.tsx` and whose overrides are in `web/desktop/desktop.css`. It does not replace the public website, browser calculator, or RoadStation visual systems. The renderer shares calculator components while applying its own desktop composition and appearance tokens.\n\nThe desk is compact and calm: inputs sit beside a larger engineering review area, with station-aware profiles as the working graphic. Borders and green-tinted neutral surfaces organize the workspace. Platform control typography keeps attention on measurements, source criteria, and local file actions. The appearance follows the operating system, including the contrast of the station cursor.",
    "keyCharacteristics": [
      "Compact inspector beside independently scrolling results.",
      "System control typography with monospaced, tabular engineering measurements.",
      "Green-tinted neutral surfaces and restrained borders in light and dark appearances.",
      "Teal and amber lane profiles, with dashed right-side traces.",
      "Persistent export actions and explicit preview and synthetic-data labels."
    ],
    "rules": [
      {
        "name": "The Appearance Pair Rule",
        "body": "Change light and dark roles together; station cursors use reading ink rather than a fixed white stroke.",
        "section": "colors"
      },
      {
        "name": "The Measured Value Rule",
        "body": "Preserve mono and tabular alignment for engineering values; do not promote status copy to the result hierarchy.",
        "section": "typography"
      },
      {
        "name": "The Review Continuity Rule",
        "body": "Keep the input inspector and review area independently scrollable while export actions remain outside their scrolling content.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** pair light and dark tokens and use reading ink for the station cursor.",
      "**Do** preserve monospaced engineering measurements, units, source criteria, and warnings.",
      "**Do** keep export actions outside the scrolling input and review panes.",
      "**Do** use authored inline SVG controls with accessible labels.",
      "**Do** identify synthetic examples and desktop evaluation access explicitly."
    ],
    "donts": [
      "**Don't** apply these desktop overrides to the public website or RoadStation.",
      "**Don't** substitute decorative imagery for the engineering diagram or obscure its axes and legend.",
      "**Don't** use character glyphs as substitutes for the authored control icons.",
      "**Don't** turn preview access, unsigned packaging, or local processing into claims of production release readiness."
    ]
  }
}
