    {
      "name": "Primary action",
      "kind": "button",
      "description": "Compact primary action using the current appearance teal.",
      "html": "<button class=\"ds-primary\">Save project\u2026</button>",
      "css": ".ds-primary{min-height:34px;padding:7px 12px;border:1px solid var(--line,#cedbd4);border-radius:6px;font-size:13px;font-weight:600;transition:.16s ease;font-family:var(--font-manrope,-apple-system),BlinkMacSystemFont,\"Segoe UI\",sans-serif;background:var(--teal,#126e5e);border-color:var(--teal,#126e5e);color:var(--panel,#fff);cursor:pointer}.ds-primary:hover{background:var(--teal-dark,#126e5e)}.ds-primary:focus-visible{outline:2px solid var(--teal,#126e5e);outline-offset:3px;}.ds-primary:disabled{opacity:.55;cursor:not-allowed}",
      "refersTo": "button-primary-light"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "description": "Quiet bordered local-file or chart action.",
      "html": "<button class=\"ds-secondary\">New project</button>",
      "css": ".ds-secondary{min-height:34px;padding:7px 12px;border:1px solid var(--line,#cedbd4);border-radius:6px;font-size:13px;font-weight:600;transition:.16s ease;font-family:var(--font-manrope,-apple-system),BlinkMacSystemFont,\"Segoe UI\",sans-serif;background:var(--raised,#f3f7f5);color:var(--ink,#1f302c);cursor:pointer}.ds-secondary:hover{background:var(--panel,#fff);border-color:var(--teal,#126e5e);color:var(--teal,#126e5e)}.ds-secondary:focus-visible{outline:2px solid var(--teal,#126e5e);outline-offset:3px;}.ds-secondary:disabled{opacity:.55;cursor:not-allowed}",
      "refersTo": "button-secondary-light"
    },
    {
      "name": "Inspector field",
      "kind": "input",
      "description": "Label and raised input retain the engineering unit.",
      "html": "<label class=\"ds-field\"><span>Radius (ft)</span><input type=\"number\" value=\"2000\" /></label>",
      "css": ".ds-field{display:grid;gap:6px;color:var(--muted,#536960);font-size:12px;font-weight:600;font-family:var(--font-manrope,-apple-system),BlinkMacSystemFont,\"Segoe UI\",sans-serif;}.ds-field input{min-height:36px;padding:7px 9px;border:1px solid var(--line,#cedbd4);border-radius:5px;background:var(--raised,#f3f7f5);color:var(--ink,#1f302c);font:400 13px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;caret-color:var(--teal,#126e5e)}.ds-field input:focus-visible{outline:2px solid var(--teal,#126e5e);outline-offset:3px;border-color:var(--teal,#126e5e);box-shadow:0 0 0 3px rgba(8,127,123,.12)}",
      "refersTo": "field-light"
    },
    {
      "name": "Input workspace selector",
      "kind": "nav",
      "description": "Two input contexts share one compact inspector.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Input workspace\"><button aria-pressed=\"true\">Curve inputs</button><button aria-pressed=\"false\">Project &amp; LandXML</button></nav>",
      "css": ".ds-nav{display:flex;gap:4px}.ds-nav button{min-height:34px;padding:7px 12px;border:1px solid var(--line,#cedbd4);border-radius:6px;font-size:13px;font-weight:600;transition:.16s ease;font-family:var(--font-manrope,-apple-system),BlinkMacSystemFont,\"Segoe UI\",sans-serif;background:transparent;border-color:transparent;color:var(--ink,#1f302c);cursor:pointer}.ds-nav button:hover{color:var(--teal,#126e5e);background:var(--panel,#fff)}.ds-nav button[aria-pressed=\"true\"]{color:var(--teal,#126e5e);background:var(--panel,#fff);border-color:var(--line,#cedbd4)}.ds-nav button:focus-visible{outline:2px solid var(--teal,#126e5e);outline-offset:3px;}"
    },
    {
      "name": "Review panel",
      "kind": "card",
      "description": "Flat pane with a restrained divider and compact section heading.",
      "html": "<section class=\"ds-panel\"><h2>Curve results</h2><p>Review stations, lane slopes, and source criteria.</p></section>",
      "css": ".ds-panel{padding:18px;border:1px solid var(--line,#cedbd4);border-radius:9px;background:var(--panel,#fff);color:var(--ink,#1f302c);box-shadow:none;font-family:var(--font-manrope,-apple-system),BlinkMacSystemFont,\"Segoe UI\",sans-serif;}.ds-panel h2{margin:0 0 18px;padding-bottom:12px;border-bottom:1px solid var(--line,#cedbd4);font-size:16px}.ds-panel p{font-size:12px;line-height:1.55;color:var(--muted,#536960)}",
      "refersTo": "panel-light"
    },
    {
      "name": "Desktop preview label",
